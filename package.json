{
  "name": "@symlab/strapi-plugin-local-image-format",
  "version": "2.1.0",
  "description": "Fork of strapi-plugin-local-image-sharp, updated to use Strapi v5. Dynamically resize, format and optimize images based on url modifiers",
  "strapi": {
    "displayName": "Local Image Format",
    "name": "local-image-format",
    "description": "Fork of strapi-plugin-local-image-sharp, updated to use Strapi v5. Dynamically resize, format and optimize images based on url modifiers",
    "required": false,
    "kind": "plugin"
  },
  "keywords": [
    "strapi",
    "plugin",
    "images",
    "sharp",
    "optimize",
    "resize"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "format": "prettier --write \"server/src/**/*.{ts,js}\"",
    "release": "npx standard-version && git push --follow-tags origin main && npm publish",
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "etag": "^1.8.1",
    "ipx": "^3.1.1",
    "ohash": "^1.1.6",
    "qs": "^6.15.2",
    "ufo": "^1.6.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.2.7",
    "@strapi/strapi": "^5.1.1"
  },
  "overrides": {
    "svgo": "^4.0.1",
    "node-forge": "^1.4.0",
    "h3": "^1.15.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@giscus/vue": "^3.1.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@koa/router": "^13.1.1",
    "@strapi/sdk-plugin": "^5.4.0",
    "@strapi/strapi": "^5.47.1",
    "@strapi/typescript-utils": "^5.47.1",
    "@types/etag": "^1.8.4",
    "@types/koa": "^2.15.2",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^25",
    "@types/qs": "^6.15.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.6"
  },
  "author": {
    "name": "Olivers De Abreu",
    "email": "olivers@symlab.io",
    "url": "https://symlab.io"
  },
  "maintainers": [
    {
      "name": "Olivers De Abreu",
      "url": "https://symlab.io"
    }
  ],
  "bugs": {
    "url": "https://github.com/Symmetrics-Lab/strapi-plugin-local-image-format/issues"
  },
  "homepage": "https://github.com/Symmetrics-Lab/strapi-plugin-local-image-format",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=6.0.0"
  },
  "license": "MIT"
}
